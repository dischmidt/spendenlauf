[Unit]
Description=@NAME@ Sponsorenlauf-App (gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@APP_USER@
Group=@APP_USER@
WorkingDirectory=@APP_DIR@
Environment=HOME=@DATA_DIR@
# Genau ein Prozess: SQLite, Ratenbegrenzung und Rundmail-Versand laufen darin
ExecStart=@APP_DIR@/.venv/bin/gunicorn --bind 127.0.0.1:@PORT@ --workers 1 --threads 8 \
    --worker-class gthread --timeout 120 --access-logfile - wsgi:app
Restart=on-failure
RestartSec=3

# Härtung (LibreOffice für den PDF-Export läuft damit weiterhin)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@DATA_DIR@
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
UMask=0027

[Install]
WantedBy=multi-user.target
