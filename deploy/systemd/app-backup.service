[Unit]
Description=@NAME@: Sicherung von Datenbank und Bildern

[Service]
Type=oneshot
User=@APP_USER@
Group=@APP_USER@
Environment=DATA_DIR=@DATA_DIR@
EnvironmentFile=-@APP_DIR@/.env
ExecStart=@APP_DIR@/.venv/bin/python @APP_DIR@/deploy/backup.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@DATA_DIR@
