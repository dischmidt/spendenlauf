# Vorlage für die .env im Programmverzeichnis (wird über python-dotenv geladen).
# deploy/install.sh legt die .env beim ersten Lauf automatisch an.

# Pflicht: zufälliger geheimer Schlüssel, z. B. python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=bitte-ersetzen

# Adresse für Testmails aus dem Admin-Bereich
ADMIN_EMAIL=admin@example.org

# Öffentliche Adresse (für Bestätigungslinks und Link-Vorschau)
BASE_URL=https://spendenlauf.example.org

# Ablage für Datenbank und hochgeladene Bilder
DATA_DIR=/var/lib/spendenlauf

# Optional: Dateiname der Datenbank in DATA_DIR (Standard: spendenlauf.db)
# DATABASE_FILE=spendenlauf.db

# Für lokale Tests ohne HTTPS auf 0 setzen
SESSION_COOKIE_SECURE=1

# Pfad zu LibreOffice für den PDF-Export der Sponsorenkarte
SOFFICE_BIN=/usr/bin/soffice

# Optional: Startwerte für den Mailserver. Werden NUR beim allerersten Start
# übernommen; danach gelten die Einstellungen im Admin-Bereich.
# SMTP_HOST=mail.example.org
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=admin@example.org
# SMTP_PASSWORD=
# MAIL_FROM=admin@example.org
